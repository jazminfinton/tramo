{
  "name": "tracking-horas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "noise": "node scripts/build-noise.mjs"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.15",
    "@date-fns/tz": "1.5.0",
    "@dnd-kit/core": "6.3.1",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.15",
    "date-fns": "4.4.0",
    "lucide-react": "^1.47.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "happy-dom": "^21.0.4",
    "pglite-prisma-adapter": "^0.7.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
